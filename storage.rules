rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // 1. Branding Folder (Site Logo, Favicon, Brand Assets)
    // Public read so all visitors across the live website, Cloudflare, and devices see the active logo
    // Write permitted only for authenticated admin
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.email == 'techtowebadmin@gmail.com' ||
        request.auth.token.admin == true
      );
    }

    // 2. Global fallback rules
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'techtowebadmin@gmail.com';
    }

  }
}
